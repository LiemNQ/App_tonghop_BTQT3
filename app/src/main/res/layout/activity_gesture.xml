<?xml version="1.0" encoding="utf-8"?><RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Bảng hiển thị kết quả nhận diện phía trên -->
    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#80000000"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/txtGestureTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI GESTURE CONTROL"
            android:textColor="#03DAC5"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/txtGestureResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ĐANG CHỜ NHẬN DIỆN..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="5dp"
            android:layout_gravity="center" />
    </LinearLayout>

    <!-- Bảng hướng dẫn cử chỉ khớp với code Java (Legend) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="15dp"
        android:padding="15dp"
        android:background="#B3000000"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HƯỚNG DẪN LỆNH"
            android:textColor="#FFEB3B"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✋ Xòe tay: BẬT QUẠT"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✊ Nắm tay: TẮT QUẠT"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✌️ Chữ V: BẬT TV"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☝️ Ngón trỏ: TẮT TV"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Nút quay lại -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        android:text="← QUAY LẠI REMOTE"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#CF6679"
        app:cornerRadius="15dp"
        android:elevation="10dp" />

</RelativeLayout>