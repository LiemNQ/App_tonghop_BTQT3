<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212"> <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="SMART REMOTE"
    android:textColor="#FFFFFF"
    android:textSize="26sp"
    android:fontFamily="sans-serif-black"
    android:layout_gravity="center"
    android:letterSpacing="0.1"
    android:layout_marginTop="20dp"
    android:layout_marginBottom="40dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#1E1E1E"> <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ QUẠT ĐIỆN"
            android:textColor="#BB86FC"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">

            <Button android:id="@+id/btnFanOn"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="BẬT"
                android:fontFamily="sans-serif-medium"
                android:backgroundTint="#03DAC5"
                android:textColor="#000000"
                android:layout_marginEnd="8dp"/>

            <Button android:id="@+id/btnFanOff"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="TẮT"
                android:fontFamily="sans-serif-medium"
                android:backgroundTint="#3700B3"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#1E1E1E">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 SMART TV"
                android:textColor="#03DAC5"
                android:textStyle="bold"
                android:textSize="18sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp">

                <Button android:id="@+id/btnTVOn"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:text="MỞ TV"
                    android:fontFamily="sans-serif-medium"
                    android:backgroundTint="#BB86FC"
                    android:textColor="#000000"
                    android:layout_marginEnd="8dp"/>

                <Button android:id="@+id/btnTVOff"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:text="TẮT TV"
                    android:fontFamily="sans-serif-medium"
                    android:backgroundTint="#CF6679"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Connected to Gateway"
        android:textColor="#444444"
        android:layout_gravity="center"
        android:layout_marginTop="30dp"
        android:textSize="12sp" />

</LinearLayout>