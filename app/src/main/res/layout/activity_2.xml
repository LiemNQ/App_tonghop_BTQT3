<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F0D"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="48dp"
    android:paddingBottom="48dp">

    <!-- Icon vòng tròn âm lượng -->
    <TextView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="🔊"
        android:textSize="52sp"
        android:background="#0F2420"
        android:layout_marginBottom="32dp" />

    <!-- Phần trăm to nổi bật -->
    <TextView
        android:id="@+id/tvVolumePercentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textColor="#1D9E75"
        android:textSize="64sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Label nhỏ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mức âm lượng hiện tại"
        android:textColor="#3A5A50"
        android:textSize="13sp"
        android:layout_marginBottom="36dp" />

    <!-- SeekBar -->
    <SeekBar
        android:id="@+id/volumeSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="#1D9E75"
        android:thumbTint="#1D9E75"
        android:progressBackgroundTint="#1A2E28"
        android:layout_marginBottom="48dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#0F2420"
        android:layout_marginBottom="32dp" />



</LinearLayout>